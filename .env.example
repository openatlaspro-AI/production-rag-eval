# Mistral API — get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_key_here

# Models — pin these for reproducible eval
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_GEN_MODEL_LARGE=mistral-large-latest
MISTRAL_GEN_MODEL_SMALL=mistral-small-latest

# Postgres (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=familyhq_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_locally

# API
API_HOST=0.0.0.0
API_PORT=8000

# Eval
EVAL_SET_PATH=eval_results/eval_set.jsonl
EVAL_RUNS_DIR=eval_results/runs

# Source data paths (gitignored — local only)
TRENDRADAR_DB_DIR=~/TrendRadar/output/news
FAMILYHQ_PRODUCTS_DIR=~/Documents/FamilyHQ/PDFs_Live
FAMILYHQ_PRODUCT_COPY=~/Documents/FamilyHQ/Scripts/upload_3_new.py
